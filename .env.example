# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Long-lived Instagram access token.
# instagram_login: an IGAA... token from App Dashboard > Instagram > API setup
#                  with Instagram Login ("Generate token" next to your account)
# facebook_login:  a long-lived Page or User token with the instagram_* scopes
IG_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Auth mode — decides host, scope family, and which tools are registered
# ---------------------------------------------------------------------------

# instagram_login (default)
#   host: graph.instagram.com
#   no Facebook Page required
#   37 tools
#   NO hashtag search, business discovery, product tagging, or media deletion
#
# facebook_login
#   host: graph.facebook.com
#   requires the Instagram account be linked to a Facebook Page you admin
#   42 tools (adds hashtag search, business discovery, Page listing, media delete)
IG_AUTH_MODE=instagram_login

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Instagram professional account ID.
# Omit on instagram_login — the token resolves it via `me`.
# REQUIRED on facebook_login. Find it with instagram_list_pages.
IG_USER_ID=

# Graph API version. Defaults to v26.0 (released 2026-07-29).
# Pin it: Meta retires a version roughly two years after release.
IG_API_VERSION=v26.0

# App credentials. Needed only for instagram_get_token_info and
# instagram_refresh_token on the facebook_login path.
IG_APP_ID=
IG_APP_SECRET=

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

# Unset (default) = stdio. Set to "http" for Streamable HTTP on 127.0.0.1.
# TRANSPORT=http
# PORT=3000
